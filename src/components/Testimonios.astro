---

const partners = [
  { name: 'Banco General', img: '/images/bg-logo.svg' },
  { name: 'BAC Credomatic', img: '/images/bac-logo.svg' },
  { name: 'Banco Nacional', img: '/images/bnp-logo.svg' },
  { name: 'Banco Devo', img: '/images/devo-logo.svg' },
];

const testimonials = [
  {
    text: '"Compré mi Tucson en Maxi Motors y todo fue transparente. Me ayudaron con el financiamiento en BAC y en 3 días ya tenía mi auto en casa."',
    author: 'María G.',
    location: 'Ciudad de Panamá',
  },
  {
    text: '"Pensaba que comprar un seminuevo era riesgoso, pero Maxi Motors me entregó el historial completo y una garantía por escrito. Muy profesionales."',
    author: 'Carlos R.',
    location: 'San Miguelito',
  },
  {
    text: '"Me guiaron por WhatsApp en todo el proceso. Ni siquiera tuve que ir al banco; ellos gestionaron todo el crédito. Recomendados al 100%."',
    author: 'Ana L.',
    location: 'David, Chiriquí',
  },
];
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Alianzas bancarias -->
    <div class="text-center mb-14">
      <h2 class="text-3xl sm:text-4xl font-bold text-primary mb-4">
        Financiamiento con los mejores bancos
      </h2>
      <p class="text-lg text-gray-600">
        Trabajamos con las principales entidades bancarias de Panamá para conseguirte la mejor tasa.
      </p>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-10 mb-20 grayscale hover:grayscale-0 transition-all">
      {partners.map(p => (
        <div class="h-12 w-36 bg-gray-100 rounded-lg flex items-center justify-center text-gray-400 text-sm font-semibold">
          {p.name}
        </div>
      ))}
    </div>

    <!-- Testimonios -->
    <div class="text-center mb-14">
      <h2 class="text-3xl sm:text-4xl font-bold text-primary mb-4">
        Lo que dicen nuestros clientes
      </h2>
      <p class="text-lg text-gray-600">
        La satisfacción de quienes ya confiaron en nosotros.
      </p>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      {testimonials.map(t => (
        <div class="bg-gr-claro p-8 rounded-2xl relative">
          <div class="flex text-yellow-400 mb-4 gap-0.5">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          </div>
          <p class="text-gray-700 leading-relaxed mb-6 italic">{t.text}</p>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center text-white font-bold text-sm">
              {t.author.charAt(0)}
            </div>
            <div>
              <p class="font-semibold text-primary text-sm">{t.author}</p>
              <p class="text-gray-500 text-xs">{t.location}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
