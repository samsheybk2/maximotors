---

---

<section class="relative min-h-[90vh] flex items-center overflow-hidden bg-primary">
  <div class="absolute inset-0 bg-gradient-to-r from-primary/95 via-primary/80 to-primary/60 z-10"></div>
  <div class="absolute inset-0 bg-[url('/images/car-hero.webp')] bg-cover bg-center"></div>

  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 w-full">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-1.5 bg-cert text-white text-sm font-semibold px-4 py-1.5 rounded-full mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        100% Certificados
      </span>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
        El auto que buscas,<br />
        <span class="text-accent">con la garantía</span> que mereces.
      </h1>

      <p class="text-lg sm:text-xl text-gray-200 mb-10 max-w-xl leading-relaxed">
        Vehículos certificados en Panamá con inspección mecánica de 140 puntos, historial limpio y financiamiento aprobado.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/inventario" class="btn-primary text-lg px-10 py-4 text-center">
          Ver Inventario →
        </a>
        <a href="/contacto" class="border-2 border-white text-white font-semibold px-10 py-4 rounded-lg hover:bg-white hover:text-primary transition duration-300 text-center">
          Agendar una cita
        </a>
      </div>

      <div class="flex items-center gap-6 mt-12 text-gray-300 text-sm">
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          140 pts. inspeccionados
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Historial certificado
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          Garantía hasta 24 meses
        </span>
      </div>
    </div>
  </div>
</section>
