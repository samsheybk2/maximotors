---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { createClient } from '../../lib/supabase';
export const prerender = false;

const supabase = createClient(Astro.cookies, Astro.request);
const { data: { user } } = await supabase.auth.getUser();
const { data: agent } = await supabase
  .from('agents')
  .select('*')
  .eq('user_id', user?.id)
  .single();

const { data: vehicles } = await supabase
  .from('vehicles')
  .select('id, brand, model, year, license_plate')
  .eq('agent_id', agent?.id)
  .eq('status', 'disponible')
  .order('created_at', { ascending: false });

const { data: categories } = await supabase
  .from('inspection_categories')
  .select('*')
  .order('display_order');

const { data: items } = await supabase
  .from('inspection_items')
  .select('*')
  .order('display_order');

function activeResult(existingItems, itemId) {
  const r = existingItems.find(e => e.item_id === itemId);
  return r ? r.result : '';
}

function btnClass(existing, result) {
  if (!existing) return 'border-gray-200 text-gray-400 hover:border-gray-300';
  if (existing.result === result) {
    if (result === 'aprobado') return 'bg-green-50 border-green-500 text-green-700';
    if (result === 'observacion') return 'bg-yellow-50 border-yellow-500 text-yellow-700';
    if (result === 'rechazado') return 'bg-red-50 border-red-500 text-red-700';
  }
  return 'border-gray-200 text-gray-400 hover:border-gray-300';
}

const inspectionId = Astro.url.searchParams.get('inspection');
let currentInspection = null;
let existingResults = [];
let inspectionVehicle = null;
if (inspectionId) {
  const { data: ins } = await supabase.from('inspections').select('*').eq('id', inspectionId).single();
  currentInspection = ins;
  if (ins?.vehicle_id) {
    const { data: vh } = await supabase.from('vehicles').select('*').eq('id', ins.vehicle_id).single();
    inspectionVehicle = vh;
  }
  const { data: res } = await supabase.from('inspection_results').select('*').eq('inspection_id', inspectionId);
  existingResults = res ?? [];
}

const { data: completedInspections } = await supabase
  .from('inspections')
  .select('*')
  .eq('agent_id', agent?.id)
  .eq('status', 'completada')
  .order('completed_at', { ascending: false });
let completedWithVehicles = [];
if (completedInspections) {
  const vIds = [...new Set(completedInspections.map(i => i.vehicle_id).filter(Boolean))];
  const { data: vhData } = await supabase.from('vehicles').select('id, brand, model, year, license_plate').in('id', vIds);
  const vhMap = Object.fromEntries((vhData ?? []).map(v => [v.id, v]));
  completedWithVehicles = completedInspections.map(i => ({ ...i, vehicle: vhMap[i.vehicle_id] || null }));
}
---

<DashboardLayout title="Certificación — Maxi Motors" user={{ email: user?.email ?? '', name: agent?.full_name ?? user?.email ?? '' }}>
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-primary">Certificación de 140 Puntos</h1>
      <p class="text-gray-500 text-sm mt-1">Inspección detallada para garantizar la calidad de cada vehículo</p>
    </div>
  </div>

  <!-- Iniciar nueva certificación -->
  {!inspectionId && (
    <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-100 mb-8">
      <h2 class="text-lg font-bold text-primary mb-5">Iniciar nueva certificación</h2>
      <form id="start-inspection" class="sm:flex gap-4 items-end" data-agent-id={agent?.id ?? ''}>
        <div class="flex-1 mb-4 sm:mb-0">
          <label class="block text-sm font-semibold text-primary mb-1">Seleccionar vehículo</label>
          <select id="vehicle-select" required>
            <option value="">— Selecciona un vehículo —</option>
            {vehicles?.map(v => (
              <option value={v.id}>{v.brand} {v.model} ({v.year}) — {v.license_plate ?? 'Sin placa'}</option>
            ))}
          </select>
          {(!vehicles || vehicles.length === 0) && (
            <p class="text-xs text-amber-600 mt-1">No hay vehículos disponibles. <a href="/dashboard/vehiculos?action=new" class="underline">Crear uno</a></p>
          )}
        </div>
        <button type="submit" class="btn-primary text-sm px-8 py-3 whitespace-nowrap">
          Iniciar Inspección →
        </button>
      </form>
      <p id="start-msg" class="mt-3 text-sm hidden"></p>
    </div>
  )}

  <!-- Formulario de inspección activa -->
  {currentInspection && (
    <>
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 mb-6">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <p class="text-sm text-gray-500">Inspección activa</p>
            <p class="font-bold text-primary">ID: {currentInspection.id.slice(0, 8)}...</p>
          </div>
          <div class="flex gap-3">
            <span id="progress-count" class="bg-blue-100 text-blue-700 text-xs font-semibold px-3 py-1.5 rounded-full">
              {items?.length ?? 0} puntos · <span id="reviewed-count">{(existingResults.filter(r => r.result !== null).length)}</span> revisados
            </span>
            {currentInspection?.status === 'completada' && (
              <a href={`/api/certificacion/${currentInspection.id}/pdf`} target="_blank"
                class="bg-cert hover:bg-green-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                Descargar PDF
              </a>
            )}
            <button id="complete-inspection" class="btn-primary text-sm px-6 py-2.5">
              Completar Certificación ✓
            </button>
          </div>
        </div>
      </div>

      <form id="inspection-form" class="space-y-6">
        <input type="hidden" name="inspection_id" value={currentInspection.id} />

        {categories?.map(cat => {
          const catItems = items?.filter(i => i.category_id === cat.id) ?? [];
          return (
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
              <div class="bg-primary px-6 py-4 flex items-center gap-3">
                <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center">
                  <span class="text-white text-xs font-bold">{cat.display_order}</span>
                </div>
                <h3 class="text-white font-bold">{cat.name}</h3>
                <span class="ml-auto text-xs text-gray-300">{catItems.length} puntos</span>
              </div>
              <div class="divide-y divide-gray-50">
                {catItems.map(item => {
                  const existing = existingResults.find(r => r.item_id === item.id);
                  return (
                    <div class="px-6 py-3 flex flex-wrap items-center gap-3 hover:bg-gray-50 transition">
                      <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-primary">{item.name}</p>
                        {item.description && <p class="text-xs text-gray-400">{item.description}</p>}
                      </div>
                      <div class="flex items-center gap-1.5">
                        <button type="button"
                          class={"result-btn px-3 py-1.5 rounded-lg text-xs font-semibold border-2 transition " + btnClass(existing, 'aprobado')}
                          data-item={item.id} data-result="aprobado" {existing?.result === 'aprobado' ? 'data-active' : ''}>
                          ✓ Aprobado
                        </button>
                        <button type="button"
                          class={"result-btn px-3 py-1.5 rounded-lg text-xs font-semibold border-2 transition " + btnClass(existing, 'observacion')}
                          data-item={item.id} data-result="observacion" {existing?.result === 'observacion' ? 'data-active' : ''}>
                          ⚠ Observación
                        </button>
                        <button type="button"
                          class={"result-btn px-3 py-1.5 rounded-lg text-xs font-semibold border-2 transition " + btnClass(existing, 'rechazado')}
                          data-item={item.id} data-result="rechazado" {existing?.result === 'rechazado' ? 'data-active' : ''}>
                          ✕ Rechazado
                        </button>
                      </div>
                      <div class="w-full sm:w-48">
                        <input type="text"
                          class={"item-note text-xs px-3 py-1.5 border rounded-lg w-full " + (existing?.notes ? 'border-gray-300' : 'border-gray-100')}
                          data-item={item.id}
                          placeholder="Nota (opcional)"
                          value={existing?.notes ?? ''} />
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })}
      </form>
    </>
  )}

  <!-- Historial -->
  {!inspectionId && (
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
      <h2 class="text-lg font-bold text-primary mb-4">Historial de Certificaciones</h2>
      {completedWithVehicles.length === 0 ? (
        <p class="text-gray-400 text-sm">No hay certificaciones completadas aún.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-gray-500 border-b">
                <th class="pb-3 pr-4 font-semibold">Vehículo</th>
                <th class="pb-3 pr-4 font-semibold">Placa</th>
                <th class="pb-3 pr-4 font-semibold">Completada</th>
                <th class="pb-3 pr-4 font-semibold">PDF</th>
              </tr>
            </thead>
            <tbody>
              {completedWithVehicles.map(ins => (
                <tr class="border-b border-gray-50 hover:bg-gray-50">
                  <td class="py-3 pr-4 font-medium text-primary">
                    {ins.vehicle ? `${ins.vehicle.brand} ${ins.vehicle.model} (${ins.vehicle.year})` : '—'}
                  </td>
                  <td class="py-3 pr-4 text-gray-500">{ins.vehicle?.license_plate ?? '—'}</td>
                  <td class="py-3 pr-4 text-gray-500">
                    {ins.completed_at ? new Date(ins.completed_at).toLocaleDateString('es-PA', { year: 'numeric', month: 'short', day: 'numeric' }) : '—'}
                  </td>
                  <td class="py-3">
                    <a href={`/api/certificacion/${ins.id}/pdf`} target="_blank"
                      class="bg-primary hover:bg-primary/80 text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition inline-flex items-center gap-1.5">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                      Descargar PDF
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  )}
</DashboardLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  // Iniciar nueva inspección
  const startForm = document.getElementById('start-inspection');
  startForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const vehicleId = document.getElementById('vehicle-select').value;
    const msg = document.getElementById('start-msg');

    if (!vehicleId) {
      msg.textContent = 'Selecciona un vehículo.';
      msg.className = 'mt-3 text-sm text-red-600';
      msg.classList.remove('hidden');
      return;
    }

    const agentId = document.getElementById('start-inspection')?.dataset.agentId;
    const { data, error } = await supabase
      .from('inspections')
      .insert({ vehicle_id: vehicleId, status: 'en_progreso', agent_id: agentId })
      .select()
      .single();

    if (error) {
      msg.textContent = 'Error: ' + error.message;
      msg.className = 'mt-3 text-sm text-red-600';
    } else {
      window.location.href = '/dashboard/certificacion?inspection=' + data.id;
    }
    msg.classList.remove('hidden');
  });

  function updateProgress() {
    const total = document.querySelectorAll('.result-btn').length;
    const reviewed = document.querySelectorAll('.result-btn[data-active="true"]').length;
    const el = document.getElementById('reviewed-count');
    if (el) el.textContent = reviewed;
  }

  // Botones de resultado
  let debounceTimers = {};

  document.querySelectorAll('.result-btn').forEach(btn => {
    btn.addEventListener('click', async function () {
      const itemId = this.dataset.item;
      const result = this.dataset.result;
      const inspectionId = document.querySelector('[name="inspection_id"]')?.value;

      // UI: highlight selected
      const group = this.closest('.flex-wrap');
      group.querySelectorAll('.result-btn').forEach(b => {
        b.removeAttribute('data-active');
        b.className = 'result-btn px-3 py-1.5 rounded-lg text-xs font-semibold border-2 transition border-gray-200 text-gray-400';
        if (b.dataset.result === 'aprobado') b.className += ' hover:border-green-300';
        else if (b.dataset.result === 'observacion') b.className += ' hover:border-yellow-300';
        else if (b.dataset.result === 'rechazado') b.className += ' hover:border-red-300';
      });
      this.setAttribute('data-active', 'true');
      this.className = 'result-btn px-3 py-1.5 rounded-lg text-xs font-semibold border-2 transition';
      if (result === 'aprobado') this.className += ' bg-green-50 border-green-500 text-green-700';
      else if (result === 'observacion') this.className += ' bg-yellow-50 border-yellow-500 text-yellow-700';
      else if (result === 'rechazado') this.className += ' bg-red-50 border-red-500 text-red-700';

      updateProgress();

      const note = group.querySelector('.item-note')?.value || '';

      // Debounce upsert
      if (debounceTimers[itemId]) clearTimeout(debounceTimers[itemId]);
      debounceTimers[itemId] = setTimeout(async () => {
        await supabase.from('inspection_results').upsert({
          inspection_id: inspectionId,
          item_id: itemId,
          result,
          notes: note || null,
        }, { onConflict: 'inspection_id, item_id' });
      }, 300);
    });
  });

  // Notas guardan automáticamente también
  document.querySelectorAll('.item-note').forEach(input => {
    input.addEventListener('input', function () {
      const itemId = this.dataset.item;
      const inspectionId = document.querySelector('[name="inspection_id"]')?.value;
      const group = this.closest('.flex-wrap');
      const activeBtn = group.querySelector('.result-btn.bg-green-50, .result-btn.bg-yellow-50, .result-btn.bg-red-50');
      const result = activeBtn?.dataset?.result || null;

      if (debounceTimers[itemId]) clearTimeout(debounceTimers[itemId]);
      debounceTimers[itemId] = setTimeout(async () => {
        if (result) {
          await supabase.from('inspection_results').upsert({
            inspection_id: inspectionId,
            item_id: itemId,
            result,
            notes: this.value || null,
          }, { onConflict: 'inspection_id, item_id' });
        }
      }, 500);
    });
  });

  // Initial count on load
  updateProgress();

  // Completar inspección
  document.getElementById('complete-inspection')?.addEventListener('click', async () => {
    if (!confirm('¿Finalizar esta certificación? Los resultados se guardarán como definitivos.')) return;

    const inspectionId = document.querySelector('[name="inspection_id"]')?.value;
    const { error } = await supabase
      .from('inspections')
      .update({ status: 'completada', completed_at: new Date().toISOString() })
      .eq('id', inspectionId);

    if (error) {
      alert('Error al completar: ' + error.message);
    } else {
      alert('✅ Certificación completada exitosamente.');
      const inspectionId2 = document.querySelector('[name="inspection_id"]')?.value;
      window.location.href = '/dashboard/certificacion?inspection=' + (inspectionId2 || '');
    }
  });
</script>
