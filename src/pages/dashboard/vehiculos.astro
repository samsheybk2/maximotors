---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { createClient } from '../../lib/supabase';
export const prerender = false;

const supabase = createClient(Astro.cookies, Astro.request);
const { data: { user } } = await supabase.auth.getUser();
const { data: agent } = await supabase
  .from('agents')
  .select('*')
  .eq('user_id', user?.id)
  .single();

const { data: vehicles } = await supabase
  .from('vehicles')
  .select('*')
  .eq('agent_id', agent?.id)
  .order('created_at', { ascending: false });

const { data: clients } = await supabase
  .from('clients')
  .select('id, full_name')
  .eq('agent_id', agent?.id)
  .order('full_name');

const action = Astro.url.searchParams.get('action');
const editId = Astro.url.searchParams.get('edit');
let editingVehicle = null;
if (editId) {
  const { data } = await supabase.from('vehicles').select('*').eq('id', editId).single();
  editingVehicle = data;
}
---

<DashboardLayout title="Vehículos — Maxi Motors" user={{ email: user?.email ?? '', name: agent?.full_name ?? user?.email ?? '' }}>
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-primary">Vehículos</h1>
      <p class="text-gray-500 text-sm mt-1">{vehicles?.length ?? 0} vehículos en inventario</p>
    </div>
    <a href="/dashboard/vehiculos?action=new" class="bg-accent hover:bg-red-700 text-white font-semibold rounded-lg transition text-sm px-5 py-2.5 inline-flex items-center gap-2 shrink-0 w-auto">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
      <span>Nuevo Vehículo</span>
    </a>
  </div>

  {(action === 'new' || editingVehicle) && (
    <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-100 mb-8">
      <h2 class="text-lg font-bold text-primary mb-5">{editingVehicle ? 'Editar Vehículo' : 'Nuevo Vehículo'}</h2>
      <form id="vehicle-form" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 uppercase-input" data-edit-brand={editingVehicle?.brand ?? ''} data-edit-model={editingVehicle?.model ?? ''} data-edit-year={editingVehicle?.year ?? ''}>
        <input type="hidden" name="id" value={editingVehicle?.id ?? ''} />
        <input type="hidden" name="agent_id" value={agent?.id ?? ''} />
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Marca *</label>
          <select name="brand" id="brand-select" required>
            <option value="">Seleccionar marca</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Modelo *</label>
          <input type="text" name="model" id="model-input" required value={editingVehicle?.model ?? ''} placeholder="Selecciona primero una marca" list="model-list" class="uppercase" disabled />
          <datalist id="model-list"></datalist>
        </div>
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Año *</label>
          <input type="text" name="year" id="year-input" required value={editingVehicle?.year ?? ''} placeholder="Selecciona primero un modelo" list="year-list" disabled />
          <datalist id="year-list"></datalist>
        </div>
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">VIN</label>
          <input type="text" name="vin" value={editingVehicle?.vin ?? ''} placeholder="NÚMERO DE SERIE" class="uppercase" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Placa</label>
          <input type="text" name="license_plate" value={editingVehicle?.license_plate ?? ''} placeholder="PLACA" class="uppercase" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Kilometraje</label>
          <input type="number" name="mileage" value={editingVehicle?.mileage ?? ''} placeholder="45000" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Color</label>
          <input type="text" name="color" value={editingVehicle?.color ?? ''} placeholder="Ej: BLANCO" class="uppercase" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Combustible</label>
          <select name="fuel_type">
            <option value="">Seleccionar</option>
            <option value="gasolina" selected={editingVehicle?.fuel_type === 'gasolina'}>Gasolina</option>
            <option value="diesel" selected={editingVehicle?.fuel_type === 'diesel'}>Diesel</option>
            <option value="hibrido" selected={editingVehicle?.fuel_type === 'hibrido'}>Híbrido</option>
            <option value="electrico" selected={editingVehicle?.fuel_type === 'electrico'}>Eléctrico</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Transmisión</label>
          <select name="transmission">
            <option value="">Seleccionar</option>
            <option value="manual" selected={editingVehicle?.transmission === 'manual'}>Manual</option>
            <option value="automatica" selected={editingVehicle?.transmission === 'automatica'}>Automática</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Precio ($)</label>
          <input type="number" name="price" step="0.01" value={editingVehicle?.price ?? ''} placeholder="34900" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Estado</label>
          <select name="status">
            <option value="disponible" selected={editingVehicle?.status === 'disponible'}>Disponible</option>
            <option value="en_proceso" selected={editingVehicle?.status === 'en_proceso'}>En Proceso</option>
            <option value="reservado" selected={editingVehicle?.status === 'reservado'}>Reservado</option>
            <option value="vendido" selected={editingVehicle?.status === 'vendido'}>Vendido</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Cliente asociado</label>
          <select name="client_id">
            <option value="">Sin cliente</option>
            {clients?.map(c => (
              <option value={c.id} selected={editingVehicle?.client_id === c.id}>{c.full_name}</option>
            ))}
          </select>
        </div>
        <div class="sm:col-span-2 lg:col-span-3">
          <label class="block text-sm font-semibold text-primary mb-1">Notas</label>
          <input type="text" name="notes" value={editingVehicle?.notes ?? ''} placeholder="NOTAS ADICIONALES" class="uppercase" />
        </div>
        <div class="sm:col-span-2 lg:col-span-3 flex gap-3">
          <button type="submit" class="btn-primary text-sm px-8 py-2.5">
            {editingVehicle ? 'Actualizar Vehículo' : 'Guardar Vehículo'}
          </button>
          <a href="/dashboard/vehiculos" class="btn-outline text-sm px-8 py-2.5">Cancelar</a>
        </div>
      </form>
      <p id="vehicle-msg" class="mt-3 text-sm hidden"></p>
    </div>
  )}

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 text-left text-gray-500 font-semibold">
            <th class="px-6 py-4">Vehículo</th>
            <th class="px-6 py-4">Año</th>
            <th class="px-6 py-4">VIN</th>
            <th class="px-6 py-4">Precio</th>
            <th class="px-6 py-4">Estado</th>
            <th class="px-6 py-4">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {vehicles?.map(v => (
            <tr class="hover:bg-gray-50 transition">
              <td class="px-6 py-4">
                <p class="font-medium text-primary">{v.brand} {v.model}</p>
                <p class="text-xs text-gray-400">{v.color ?? ''} · {v.mileage ? `${v.mileage.toLocaleString()} km` : '—'}</p>
              </td>
              <td class="px-6 py-4">{v.year}</td>
              <td class="px-6 py-4 text-xs text-gray-500 font-mono">{v.vin ?? '—'}</td>
              <td class="px-6 py-4 font-semibold">{v.price ? `$${v.price.toLocaleString()}` : '—'}</td>
              <td class="px-6 py-4">
                <span class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold ${
                  v.status === 'disponible' ? 'bg-green-100 text-green-700' :
                  v.status === 'vendido' ? 'bg-gray-100 text-gray-600' :
                  v.status === 'reservado' ? 'bg-yellow-100 text-yellow-700' :
                  'bg-blue-100 text-blue-700'
                }`}>
                  {v.status === 'disponible' ? 'Disponible' :
                   v.status === 'vendido' ? 'Vendido' :
                   v.status === 'reservado' ? 'Reservado' : 'En Proceso'}
                </span>
              </td>
              <td class="px-6 py-4">
                <div class="flex gap-2">
                  <a href={`/dashboard/vehiculos?edit=${v.id}`} class="text-primary hover:text-accent text-sm font-semibold">Editar</a>
                  <button class="delete-btn text-red-600 hover:text-red-800 text-sm font-semibold" data-id={v.id}>Eliminar</button>
                </div>
              </td>
            </tr>
          ))}
          {(!vehicles || vehicles.length === 0) && (
            <tr><td colspan="6" class="px-6 py-12 text-center text-gray-400">No hay vehículos registrados aún.</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </div>
</DashboardLayout>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { brands, vehicleData } from '../../data/vehicles';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const form = document.getElementById('vehicle-form');
  const brandSelect = document.getElementById('brand-select');
  const modelInput = document.getElementById('model-input');
  const modelList = document.getElementById('model-list');
  const yearInput = document.getElementById('year-input');
  const yearList = document.getElementById('year-list');

  const editingBrand = form?.dataset.editBrand || null;
  const editingModel = form?.dataset.editModel || null;
  const editingYear = form?.dataset.editYear || null;

  brands.forEach(b => {
    const opt = document.createElement('option');
    opt.value = b; opt.textContent = b;
    if (b === editingBrand) opt.selected = true;
    brandSelect?.appendChild(opt);
  });

  function updateModels(selectedBrand) {
    modelInput.value = '';
    modelInput.disabled = true;
    modelInput.placeholder = 'Primero selecciona una marca';
    modelList.innerHTML = '';
    yearInput.value = '';
    yearInput.disabled = true;
    yearInput.placeholder = 'Primero selecciona un modelo';
    yearList.innerHTML = '';

    if (!selectedBrand || !vehicleData[selectedBrand]) return;

    const models = Object.keys(vehicleData[selectedBrand].models).sort();
    models.forEach(m => {
      const opt = document.createElement('option');
      opt.value = m;
      modelList?.appendChild(opt);
    });
    modelInput.disabled = false;
    modelInput.placeholder = 'Escribe o selecciona un modelo';

    if (editingBrand === selectedBrand) {
      modelInput.value = editingModel && models.includes(editingModel)
        ? editingModel
        : (editingModel || '');
      updateYears(modelInput.value, selectedBrand);
    }
  }

  function updateYears(selectedModel, selectedBrand) {
    yearInput.value = '';
    yearInput.disabled = true;
    yearInput.placeholder = 'Primero selecciona un modelo';
    yearList.innerHTML = '';

    const brand = selectedBrand || brandSelect?.value;
    if (!brand || !selectedModel || !vehicleData[brand]?.models[selectedModel]) {
      yearInput.disabled = false;
      yearInput.placeholder = 'Escribe el año';
      return;
    }

    const years = vehicleData[brand].models[selectedModel].slice().reverse();
    years.forEach(y => {
      const opt = document.createElement('option');
      opt.value = y;
      yearList?.appendChild(opt);
    });
    yearInput.disabled = false;
    yearInput.placeholder = 'Escribe o selecciona un año';

    if (editingModel === selectedModel && editingBrand === brand && editingYear) {
      yearInput.value = editingYear;
    } else if (editingBrand === brand && editingModel === selectedModel) {
      yearInput.value = editingYear || '';
    }
  }

  brandSelect?.addEventListener('change', () => {
    updateModels(brandSelect.value);
  });

  modelInput?.addEventListener('input', () => {
    updateYears(modelInput.value);
  });

  if (editingBrand) {
    updateModels(editingBrand);
  }

  document.querySelectorAll('#vehicle-form input.uppercase').forEach(inp => {
    inp.addEventListener('input', () => { inp.value = inp.value.toUpperCase(); });
  });

  function toUppercase(val) {
    return typeof val === 'string' ? val.toUpperCase() : val;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const id = fd.get('id');
    const payload = {
      agent_id: fd.get('agent_id') || null,
      brand: fd.get('brand'),
      model: fd.get('model'),
      year: fd.get('year') ? parseInt(fd.get('year')) : null,
      vin: toUppercase(fd.get('vin')) || null,
      license_plate: toUppercase(fd.get('license_plate')) || null,
      mileage: fd.get('mileage') ? parseInt(fd.get('mileage')) : null,
      color: toUppercase(fd.get('color')) || null,
      fuel_type: fd.get('fuel_type') || null,
      transmission: fd.get('transmission') || null,
      price: fd.get('price') ? parseFloat(fd.get('price')) : null,
      status: fd.get('status') || 'disponible',
      client_id: fd.get('client_id') || null,
      notes: toUppercase(fd.get('notes')) || null,
    };

    const msg = document.getElementById('vehicle-msg');
    let error;
    if (id) {
      ({ error } = await supabase.from('vehicles').update(payload).eq('id', id));
    } else {
      ({ error } = await supabase.from('vehicles').insert(payload));
    }

    if (error) {
      msg.textContent = 'Error: ' + error.message;
      msg.className = 'mt-3 text-sm text-red-600';
    } else {
      msg.textContent = id ? 'Vehículo actualizado.' : 'Vehículo creado correctamente.';
      msg.className = 'mt-3 text-sm text-green-600';
      setTimeout(() => window.location.href = '/dashboard/vehiculos', 800);
    }
    msg.classList.remove('hidden');
  });

  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('¿Eliminar este vehículo?')) return;
      const { error } = await supabase.from('vehicles').delete().eq('id', btn.dataset.id);
      if (!error) window.location.reload();
    });
  });
</script>
