---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { createClient } from '../../lib/supabase';
export const prerender = false;

const supabase = createClient(Astro.cookies, Astro.request);
let userEmail = '';
let userName = 'Agente';
let agentName = 'Agente';
let clientsCount = 0;
let vehiclesCount = 0;
let inspectionsCount = 0;

try {
  const { data: { user } } = await supabase.auth.getUser();
  if (user) {
    userEmail = user.email ?? '';
    const { data: agent } = await supabase
      .from('agents')
      .select('*')
      .eq('user_id', user.id)
      .single();
    if (agent) {
      agentName = agent.full_name?.split(' ')[0] ?? 'Agente';
      userName = agent.full_name ?? user.email ?? '';
    }
    const agentId = agent?.id;
    if (agentId) {
      const { count: cc } = await supabase.from('clients').select('*', { count: 'exact', head: true }).eq('agent_id', agentId);
      clientsCount = cc ?? 0;
      const { count: vc } = await supabase.from('vehicles').select('*', { count: 'exact', head: true }).eq('agent_id', agentId);
      vehiclesCount = vc ?? 0;
      const { count: ic } = await supabase.from('inspections').select('*', { count: 'exact', head: true }).eq('agent_id', agentId);
      inspectionsCount = ic ?? 0;
    }
  }
} catch {}
---

<DashboardLayout title="Dashboard — Maxi Motors" user={{ email: userEmail, name: userName }}>
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-primary">Bienvenido, {agentName}</h1>
    <p class="text-gray-500 mt-1">Resumen de tu actividad en Maxi Motors</p>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
      </div>
      <p class="text-3xl font-bold text-primary">{clientsCount}</p>
      <p class="text-gray-500 text-sm">Clientes registrados</p>
      <a href="/dashboard/clientes" class="text-accent text-sm font-semibold hover:underline mt-2 inline-block">Gestionar →</a>
    </div>

    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8m-4-4v4M8 14h8m-8 4h4m-6-8h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
      </div>
      <p class="text-3xl font-bold text-primary">{vehiclesCount}</p>
      <p class="text-gray-500 text-sm">Vehículos en inventario</p>
      <a href="/dashboard/vehiculos" class="text-accent text-sm font-semibold hover:underline mt-2 inline-block">Gestionar →</a>
    </div>

    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
      </div>
      <p class="text-3xl font-bold text-primary">{inspectionsCount}</p>
      <p class="text-gray-500 text-sm">Certificaciones realizadas</p>
      <a href="/dashboard/certificacion" class="text-accent text-sm font-semibold hover:underline mt-2 inline-block">Nueva certificación →</a>
    </div>
  </div>

  <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-100">
    <h2 class="text-xl font-bold text-primary mb-4">Acceso rápido</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <a href="/dashboard/clientes?action=new" class="flex items-center gap-3 p-4 border-2 border-dashed border-gray-200 rounded-xl hover:border-accent hover:bg-red-50 transition group">
        <svg class="w-6 h-6 shrink-0 text-gray-300 group-hover:text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
        </svg>
        <span class="text-sm font-semibold text-gray-400 group-hover:text-accent">Nuevo Cliente</span>
      </a>
      <a href="/dashboard/vehiculos?action=new" class="flex items-center gap-3 p-4 border-2 border-dashed border-gray-200 rounded-xl hover:border-accent hover:bg-red-50 transition group">
        <svg class="w-6 h-6 shrink-0 text-gray-300 group-hover:text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
        <span class="text-sm font-semibold text-gray-400 group-hover:text-accent">Nuevo Vehículo</span>
      </a>
      <a href="/dashboard/certificacion" class="flex items-center gap-3 p-4 border-2 border-dashed border-gray-200 rounded-xl hover:border-accent hover:bg-red-50 transition group">
        <svg class="w-6 h-6 shrink-0 text-gray-300 group-hover:text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="text-sm font-semibold text-gray-400 group-hover:text-accent">Certificar Vehículo</span>
      </a>
      <a href="/" target="_blank" class="flex items-center gap-3 p-4 border-2 border-dashed border-gray-200 rounded-xl hover:border-primary hover:bg-blue-50 transition group">
        <svg class="w-6 h-6 shrink-0 text-gray-300 group-hover:text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
        <span class="text-sm font-semibold text-gray-400 group-hover:text-primary">Ver Sitio Web</span>
      </a>
    </div>
  </div>
</DashboardLayout>
