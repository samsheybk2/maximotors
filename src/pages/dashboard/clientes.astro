---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { createClient } from '../../lib/supabase';
export const prerender = false;

const supabase = createClient(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();
const { data: agent } = await supabase
  .from('agents')
  .select('*')
  .eq('user_id', user?.id)
  .single();

const { data: clients } = await supabase
  .from('clients')
  .select('*')
  .eq('agent_id', agent?.id)
  .order('created_at', { ascending: false });

const action = Astro.url.searchParams.get('action');
const editId = Astro.url.searchParams.get('edit');
let editingClient = null;
if (editId) {
  const { data } = await supabase.from('clients').select('*').eq('id', editId).single();
  editingClient = data;
}
---

<DashboardLayout title="Clientes — Maxi Motors" user={{ email: user?.email ?? '', name: agent?.full_name ?? user?.email ?? '' }}>
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-primary">Clientes</h1>
      <p class="text-gray-500 text-sm mt-1">{clients?.length ?? 0} clientes registrados</p>
    </div>
    <a href="/dashboard/clientes?action=new" class="btn-primary text-sm px-5 py-2.5 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
      Nuevo Cliente
    </a>
  </div>

  <!-- Formulario nuevo/editar -->
  {(action === 'new' || editingClient) && (
    <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-100 mb-8">
      <h2 class="text-lg font-bold text-primary mb-5">{editingClient ? 'Editar Cliente' : 'Nuevo Cliente'}</h2>
      <form id="client-form" class="grid sm:grid-cols-2 gap-4">
        <input type="hidden" name="id" value={editingClient?.id ?? ''} />
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Nombre completo</label>
          <input type="text" name="full_name" required value={editingClient?.full_name ?? ''} placeholder="Ej: Juan Pérez" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Correo electrónico</label>
          <input type="email" name="email" value={editingClient?.email ?? ''} placeholder="cliente@correo.com" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Teléfono / WhatsApp</label>
          <input type="tel" name="phone" value={editingClient?.phone ?? ''} placeholder="+507 6XXX-XXXX" />
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-sm font-semibold text-primary mb-1">Tipo ID</label>
            <select name="id_type">
              <option value="">Seleccionar</option>
              <option value="cedula" selected={editingClient?.id_type === 'cedula'}>Cédula</option>
              <option value="pasaporte" selected={editingClient?.id_type === 'pasaporte'}>Pasaporte</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-primary mb-1">Número ID</label>
            <input type="text" name="id_number" value={editingClient?.id_number ?? ''} placeholder="8-XXX-XXXX" />
          </div>
        </div>
        <div class="sm:col-span-2">
          <label class="block text-sm font-semibold text-primary mb-1">Dirección</label>
          <input type="text" name="address" value={editingClient?.address ?? ''} placeholder="Dirección completa" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Ciudad</label>
          <input type="text" name="city" value={editingClient?.city ?? 'Ciudad de Panamá'} />
        </div>
        <div>
          <label class="block text-sm font-semibold text-primary mb-1">Notas</label>
          <input type="text" name="notes" value={editingClient?.notes ?? ''} placeholder="Notas adicionales" />
        </div>
        <div class="sm:col-span-2 flex gap-3">
          <button type="submit" class="btn-primary text-sm px-8 py-2.5">
            {editingClient ? 'Actualizar Cliente' : 'Guardar Cliente'}
          </button>
          <a href="/dashboard/clientes" class="btn-outline text-sm px-8 py-2.5">Cancelar</a>
        </div>
      </form>
      <p id="client-msg" class="mt-3 text-sm hidden"></p>
    </div>
  )}

  <!-- Tabla -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 text-left text-gray-500 font-semibold">
            <th class="px-6 py-4">Nombre</th>
            <th class="px-6 py-4">Teléfono</th>
            <th class="px-6 py-4">Email</th>
            <th class="px-6 py-4">Ciudad</th>
            <th class="px-6 py-4">Registrado</th>
            <th class="px-6 py-4">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {clients?.map(c => (
            <tr class="hover:bg-gray-50 transition">
              <td class="px-6 py-4 font-medium text-primary">{c.full_name}</td>
              <td class="px-6 py-4 text-gray-600">{c.phone ?? '—'}</td>
              <td class="px-6 py-4 text-gray-600">{c.email ?? '—'}</td>
              <td class="px-6 py-4">{c.city}</td>
              <td class="px-6 py-4 text-gray-500 text-xs">{new Date(c.created_at).toLocaleDateString('es-PA')}</td>
              <td class="px-6 py-4">
                <div class="flex gap-2">
                  <a href={`/dashboard/clientes?edit=${c.id}`} class="text-primary hover:text-accent text-sm font-semibold">Editar</a>
                  <button class="delete-btn text-red-600 hover:text-red-800 text-sm font-semibold" data-id={c.id}>Eliminar</button>
                </div>
              </td>
            </tr>
          ))}
          {(!clients || clients.length === 0) && (
            <tr><td colspan="6" class="px-6 py-12 text-center text-gray-400">No hay clientes registrados aún. ¡Crea tu primer cliente!</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </div>
</DashboardLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const form = document.getElementById('client-form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const id = fd.get('id');
    const payload = {
      full_name: fd.get('full_name'),
      email: fd.get('email') || null,
      phone: fd.get('phone') || null,
      id_type: fd.get('id_type') || null,
      id_number: fd.get('id_number') || null,
      address: fd.get('address') || null,
      city: fd.get('city') || 'Ciudad de Panamá',
      notes: fd.get('notes') || null,
    };

    const msg = document.getElementById('client-msg');
    let error;
    if (id) {
      ({ error } = await supabase.from('clients').update(payload).eq('id', id));
    } else {
      ({ error } = await supabase.from('clients').insert(payload));
    }

    if (error) {
      msg.textContent = 'Error: ' + error.message;
      msg.className = 'mt-3 text-sm text-red-600';
    } else {
      msg.textContent = id ? 'Cliente actualizado correctamente.' : 'Cliente creado correctamente.';
      msg.className = 'mt-3 text-sm text-green-600';
      setTimeout(() => window.location.href = '/dashboard/clientes', 800);
    }
    msg.classList.remove('hidden');
  });

  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('¿Eliminar este cliente?')) return;
      const { error } = await supabase.from('clients').delete().eq('id', btn.dataset.id);
      if (!error) window.location.reload();
    });
  });
</script>
