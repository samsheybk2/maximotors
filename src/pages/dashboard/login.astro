---
import Layout from '../../layouts/Layout.astro';
export const prerender = false;
---

<Layout title="Acceso Agente — Maxi Motors">
  <section class="min-h-screen bg-primary flex items-center justify-center px-4">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center mx-auto mb-4">
          <span class="text-primary font-extrabold text-2xl">M</span>
        </div>
        <h1 class="text-3xl font-bold text-white">Panel del Agente</h1>
        <p class="text-gray-400 mt-2">Inicia sesión para gestionar clientes, vehículos y certificaciones</p>
      </div>

      <div class="bg-white rounded-2xl p-8 shadow-xl">
        <form id="login-form" class="space-y-5">
          <div>
            <label for="email" class="block text-sm font-semibold text-primary mb-1.5">Correo electrónico</label>
            <input type="email" id="email" name="email" required placeholder="agente@maximotors.pa" />
          </div>
          <div>
            <label for="password" class="block text-sm font-semibold text-primary mb-1.5">Contraseña</label>
            <input type="password" id="password" name="password" required placeholder="••••••••" />
          </div>
          <button type="submit" class="btn-primary w-full text-lg py-3">
            Ingresar →
          </button>
          <p id="error-msg" class="text-red-600 text-sm text-center hidden"></p>
        </form>
        <p class="text-center text-sm text-gray-500 mt-6">
          ¿No tienes cuenta? <a href="/contacto" class="text-accent font-semibold hover:underline">Solicitar acceso</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  document.getElementById('login-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('email').value;
    const password = document.getElementById('password').value;
    const errorMsg = document.getElementById('error-msg');

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    if (error) {
      errorMsg.textContent = 'Credenciales inválidas. Verifica tu correo y contraseña.';
      errorMsg.classList.remove('hidden');
    } else {
      window.location.href = '/dashboard';
    }
  });
</script>
