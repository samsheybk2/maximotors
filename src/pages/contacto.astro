---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto — Maxi Motors | Vehículos Certificados Panamá" description="Contáctanos. Estamos en Vía Ricardo J. Alfaro, Panamá. WhatsApp, teléfono y formulario online.">
  <section class="bg-primary py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white mb-4">Contacto</h1>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto">
        Estamos listos para ayudarte. Elige el canal de tu preferencia.
      </p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16">
        <div>
          <h2 class="text-3xl font-bold text-primary mb-8">Escríbenos</h2>
          <form class="space-y-6" action="#" method="POST">
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="nombre" class="block text-sm font-semibold text-primary mb-1.5">Nombre completo</label>
                <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre" />
              </div>
              <div>
                <label for="email" class="block text-sm font-semibold text-primary mb-1.5">Correo electrónico</label>
                <input type="email" id="email" name="email" required placeholder="correo@ejemplo.com" />
              </div>
            </div>
            <div>
              <label for="telefono" class="block text-sm font-semibold text-primary mb-1.5">Teléfono / WhatsApp</label>
              <input type="tel" id="telefono" name="telefono" placeholder="+507 6XXX-XXXX" />
            </div>
            <div>
              <label for="mensaje" class="block text-sm font-semibold text-primary mb-1.5">Mensaje</label>
              <textarea id="mensaje" name="mensaje" rows="5" required placeholder="¿Qué vehículo te interesa? Cuéntanos más..." class="border border-gray-300 rounded-lg px-4 py-3 w-full text-sm focus:ring-2 focus:ring-accent focus:border-accent outline-none transition resize-none"></textarea>
            </div>
            <button type="submit" class="btn-primary text-lg px-12 w-full sm:w-auto">
              Enviar Mensaje →
            </button>
          </form>

          <div class="mt-12 space-y-4">
            <div class="flex items-center gap-4 p-4 bg-gr-claro rounded-xl">
              <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="font-semibold text-primary">Teléfono</p>
                <a href="tel:+50760000000" class="text-gray-600 hover:text-accent">+507 6000-0000</a>
              </div>
            </div>
            <div class="flex items-center gap-4 p-4 bg-gr-claro rounded-xl">
              <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              </div>
              <div>
                <p class="font-semibold text-primary">WhatsApp</p>
                <a href="https://wa.me/50760000000" target="_blank" class="text-gray-600 hover:text-accent">+507 6000-0000</a>
              </div>
            </div>
            <div class="flex items-center gap-4 p-4 bg-gr-claro rounded-xl">
              <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="font-semibold text-primary">Email</p>
                <a href="mailto:info@maximotors.pa" class="text-gray-600 hover:text-accent">info@maximotors.pa</a>
              </div>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-3xl font-bold text-primary mb-8">Visítanos</h2>
          <div class="bg-gray-200 rounded-2xl h-80 flex items-center justify-center text-gray-500 mb-6">
            <div class="text-center">
              <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              Mapa — Vía Ricardo J. Alfaro, Panamá
            </div>
          </div>
          <div class="bg-gr-claro rounded-2xl p-6">
            <h3 class="font-bold text-primary mb-3">Horario de Atención</h3>
            <div class="space-y-2 text-sm text-gray-600">
              <div class="flex justify-between">
                <span>Lunes — Viernes</span>
                <span class="font-semibold">8:00 AM — 6:00 PM</span>
              </div>
              <div class="flex justify-between">
                <span>Sábados</span>
                <span class="font-semibold">9:00 AM — 1:00 PM</span>
              </div>
              <div class="flex justify-between">
                <span>Domingos</span>
                <span class="font-semibold text-gray-400">Cerrado</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
