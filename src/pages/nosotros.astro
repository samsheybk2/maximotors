---
import Layout from '../layouts/Layout.astro';
import Nosotros from '../components/Nosotros.astro';
import Testimonios from '../components/Testimonios.astro';
---

<Layout title="Nosotros — Maxi Motors | Transparencia y Confianza" description="Conoce Maxi Motors, tu concesionario de vehículos certificados en Panamá. Transparencia, garantía y financiamiento.">
  <section class="bg-primary py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white mb-4">Nosotros</h1>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto">
        Más de 10 años ofreciendo vehículos certificados con transparencia y calidad en Panamá.
      </p>
    </div>
  </section>

  <Nosotros />

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-bold text-primary mb-4">Nuestros Valores</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">Los pilares que guían cada venta y cada relación con nuestros clientes.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-8">
        <div class="text-center p-8">
          <div class="w-16 h-16 bg-primary rounded-2xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Transparencia Total</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Mostramos el historial completo de cada vehículo. Sin sorpresas, sin letra pequeña.</p>
        </div>
        <div class="text-center p-8">
          <div class="w-16 h-16 bg-primary rounded-2xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Garantía Real</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Respaldamos cada venta con una garantía escrita. No es un eslogan, es un compromiso legal.</p>
        </div>
        <div class="text-center p-8">
          <div class="w-16 h-16 bg-primary rounded-2xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Atención Personalizada</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Te asignamos un asesor único de principio a fin. Sin vueltas, sin esperas.</p>
        </div>
      </div>
    </div>
  </section>

  <Testimonios />
</Layout>
